# Supabase Configuration
# Get these from your Supabase Dashboard → Project Settings → Database
# Connection URL (use Connection Pooler for app)
DATABASE_URL="postgres://postgres.xxxxxxx:password@aws-0-xxxxx.pooler.supabase.com:6543/postgres"
# Direct URL (for Prisma migrations)
DIRECT_URL="postgresql://postgres:password@db.xxxxxxx.supabase.co:5432/postgres"

# JWT Secret (generate a strong random string)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
CLIENT_URL="http://localhost:5173"
UPLOAD_DIR="uploads"
